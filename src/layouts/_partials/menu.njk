{# {% include "../_partials/i18n.njk" %} #}
<div class="running-head">
    {% if class != "homepage" %}
        {% if lang == "en" %}
            <a class="back-home" href="{{ "/" }}">{% include "_partials/logo.njk" %}</a>
        {% else %}
            <a class="back-home" href="/{{ lang }}/">{% include "_partials/logo.njk" %}</a>
        {% endif %}
    {% endif %}
    <button class="menu-call">MENU</button>
    <nav class="menu hide" role="main">
        <ul>
            {% for contentitem in collections.sortedByOrder | findmenu | orderedMenu(sitemenu, lang) %}
                <li class="{% if contentitem.url == page.url %}active{% endif %}                         {% if contentitem.data.lang=="en" and lang !="en" %}englishOnly{% endif %} ">
                    <a href="{{ contentitem.url }}">{{ contentitem.data.menu }}
                        {% if contentitem.data.lang=="en" and lang !="en" %}<sup>en</sup>{% endif %}
                    </a>
                </li>
            {% endfor %}
            <li>
                <a class=github-link"
                href="https://github.com/pagedjs/pagedjs/">github</a>
            </li>
            <li>
                <a class="rsslink" href="https://pagedjs.org/feed.xml">RSS</a>
            </li>
        </ul>
    </nav>
</div>
